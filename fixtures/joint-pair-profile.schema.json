{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic joint-pair profile over the unchanged schema_v0 envelope",
  "description": "A stricter fixture profile, not a replacement for Agora schema_v0. Upstream reference: https://github.com/DanceNitra/agora/blob/d7431a5319a84be8acb79db2b6305ae1035ca3d9/research/schema_v0.json",
  "type": "object",
  "required": ["version", "fact_record"],
  "properties": {
    "version": {"const": "schema_v0"},
    "fact_record": {
      "type": "object",
      "required": ["id", "key", "subject", "relation", "object", "text", "valid_from", "recorded_at", "sources", "corroboration_count", "status", "writer_metadata"],
      "properties": {
        "id": {"type": "string", "pattern": "^synthetic-joint-", "maxLength": 512},
        "key": {"type": "string"},
        "subject": {"type": "string"},
        "relation": {"const": "auth-method"},
        "object": {"type": "null"},
        "text": {"type": "string", "maxLength": 32768},
        "valid_from": {"type": "number"},
        "recorded_at": {"type": "number"},
        "sources": {"type": "array", "minItems": 1, "maxItems": 1, "items": {
          "type": "object", "required": ["channel", "principal"],
          "properties": {"channel": {"const": "unknown"}, "principal": {"const": "synthetic-billing-team"}}
        }},
        "corroboration_count": {"const": 1},
        "status": {"const": "active"},
        "writer_metadata": {
          "type": "object", "required": ["source", "source_provenance"],
          "properties": {"source_provenance": {
            "type": "object", "required": ["version", "associations"],
            "properties": {
              "version": {"const": "source_provenance_v1"},
              "associations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {
                "type": "object", "required": ["role", "source_index", "writer_record_id", "source"],
                "properties": {"role": {"enum": ["primary", "linked"]}, "source_index": {"const": 0},
                  "writer_record_id": {"type": "string"}, "source": {"type": "object", "required": ["principal", "doc"]}}
              }}
            }
          }}
        }
      }
    }
  }
}
